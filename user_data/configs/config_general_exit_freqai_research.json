{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 1.0,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "dataformat_ohlcv": "feather",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "skip_pair_validation": true,
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "freqai": {
    "enabled": true,
    "activate_tensorboard": false,
    "purge_old_models": 1,
    "train_period_days": 365,
    "backtest_period_days": 90,
    "live_retrain_hours": 0,
    "identifier": "general-exit-target-quality-placeholder",
    "feature_parameters": {
      "include_timeframes": [
        "1h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 24,
      "include_shifted_candles": 0,
      "DI_threshold": 0,
      "weight_factor": 0.999,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        14
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {}
  },
  "bot_name": "general_exit_freqai_research",
  "force_entry_enable": false,
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  }
}
